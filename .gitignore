node_modules/
.DS_Store
.omc/
dist-zips/
# Tree-bound validation receipt written by scripts/validate-plugin.mjs as a
# sibling of the validated plugin dir. Never a tracked artifact — it binds a
# specific tree at validate time and is consumed by the stage-12 submit gate.
validation-receipt.json
validation-receipt.json.tmp
# Render-harness output (screenshots + metadata) — transient, never tracked.
test-results/
# Ignore dist by default, but track built plugin & shared-package outputs.
# CI builds these on push to main and commits them back so users get
# runnable plugins on a fresh `/plugin install` (no host-side build step).
dist/
!plugins/*/mcp-server/dist/
!plugins/*/ui-handlers/*/component/out/
!plugins/*/view-tool/dist/
!plugins/*/view-tool/dist/ui-resources/
!packages/*/dist/
# agntux-build ships the build/validate toolchain in-bundle so validation runs
# in a contributor sandbox with no marketplace clone. The bundled @agntux/*
# package dist trees under canonical/packages/ are tracked artifacts
# (sync-agntux-build-toolchain.mjs vendors them from packages/*/dist).
!plugins/agntux-build/canonical/packages/*/dist/
# The vendored, self-contained @agntux/plugin-runtime ships yaml + zod under
# node_modules so a Node load of dist/parse-action.js (`import {parse} from
# "yaml"`) resolves via ESM walk-up in the shipped bundle with no install. These
# are tracked artifacts (sync-agntux-build-toolchain.mjs vendors them from the
# repo-root node_modules); force-track them past the blanket node_modules/ rule.
# (host-renderer/vendor/ has its own re-include in host-renderer/.gitignore.)
!plugins/agntux-build/canonical/packages/plugin-runtime/node_modules/
!plugins/agntux-build/canonical/packages/plugin-runtime/node_modules/**
