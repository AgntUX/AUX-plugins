node_modules/
.DS_Store
.omc/
# Ignore dist by default, but track built plugin & shared-package outputs.
# CI builds these on push to main and commits them back so users get
# runnable plugins on a fresh `/plugin install` (no host-side build step).
dist/
!plugins/*/mcp-server/dist/
!plugins/*/ui-handlers/*/component/out/
!plugins/*/view-tool/dist/
!plugins/*/view-tool/dist/ui-resources/
!packages/*/dist/
