            "type": "string"
          },
          "events_count": {
            "type": "number"
          },
          "users_affected": {
            "type": "number"
          },
          "ignore_mode": {
            "type": "string"
          },
          "ignore_duration_minutes": {
            "type": "number"
          },
          "ignore_count": {
