{
  "name": "@agntux/orchestrator-mcp-server",
  "version": "1.2.0",
  "description": "Local stdio MCP server for the agntux-core orchestrator plugin. Also exposes the AgntUX project-root resolver as a sibling-plugin library subpath so other AgntUX plugins (e.g. agntux-slack) can reuse the same resolver instead of vendor-copying.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agntux-root": {
      "types": "./dist/agntux-root.d.ts",
      "import": "./dist/agntux-root.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node scripts/embed-bundle.mjs",
    "check:bundle-sync": "node scripts/check-bundle-sync.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@agntux/mcp-license": "file:../../../packages/mcp-license",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
