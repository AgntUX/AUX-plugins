{
  "mcpServers": {
    "agntux-core": {
      "command": "/bin/sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/agntux-node.sh",
        "${CLAUDE_PLUGIN_ROOT}/mcp-server/dist/index.js"
      ],
      "env": {
        "AGNTUX_APP_ID": "${AGNTUX_APP_ID}",
        "AGNTUX_DISABLE_TELEMETRY": "${AGNTUX_DISABLE_TELEMETRY}",
        "SENTRY_DSN_PLUGINS": "${SENTRY_DSN_PLUGINS}"
      }
    }
  }
}
