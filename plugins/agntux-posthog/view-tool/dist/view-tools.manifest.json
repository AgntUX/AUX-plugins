{
  "plugin_slug": "agntux_posthog",
  "plugin_version": "0.2.1",
  "handler_module": "view-tool/dist/agntux-posthog-view.js",
  "view_tools": [
    {
      "name": "agntux_posthog_resolve",
      "description": "Use this to resolve or reassign a PostHog error tracking issue. Shown when the user wants to update the status or assignee of an error issue. This tool is an MCP App view tool: it returns a structured data payload that the host (Claude Desktop / Claude Cowork / Claude Code) renders into an interactive iframe shown above the next assistant turn. The iframe is the user-visible result of calling this tool; no additional chat output, summary, or visualization tool call is needed afterwards.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string"
          }
        },
        "required": [
          "action_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "action_id": {
            "type": "string"
          },
          "issue_url": {
            "type": "string"
          },
          "issue_id": {
            "type": "string"
          },
          "issue_title": {
            "type": "string"
          },
          "occurrence_summary": {
            "type": "string"
          },
          "current_status": {
            "type": "string"
          },
          "current_assignee": {
            "type": "string"
          },
          "candidate_assignees": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_status": {
            "type": "string"
          }
        },
        "required": [
          "action_id",
          "issue_url",
          "issue_id",
          "issue_title",
          "occurrence_summary",
          "current_status",
          "current_assignee",
          "candidate_assignees",
          "target_status"
        ],
        "additionalProperties": false
      },
      "data_paths": [
        {
          "pattern": "actions/{id}.md",
          "scope": "personal"
        }
      ],
      "mcp_app_meta": {
        "resourceUri": "ui://agntux-posthog/resolve",
        "csp": {
          "connectDomains": [],
          "resourceDomains": [],
          "frameDomains": [],
          "baseUriDomains": []
        },
        "permissions": {}
      }
    },
