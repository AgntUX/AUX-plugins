{
  "name": "@agntux/agntux-slack-plugin",
  "version": "0.2.0",
  "description": "Tests for the agntux-slack plugin",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs agntux-slack",
    "start:http": "HTTP_MODE=1 node mcp-server/dist/index.js",
    "dev": "npm run build && npm run start:http",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "workspaces": [
    "ui-handlers/compose/component",
    "ui-handlers/canvas/component",
    "mcp-server"
  ]
}
